// Generated schema — modeled after beautyhqio conventions.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  active       Boolean @default(true)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model WorkflowAnalysis {
 id String @id @default(cuid())
 actorId String
 workflow String
 subjectEntity String
 subjectId String
 input Json
 evidence Json
 evidenceHash String
 result Json
 model String
 receipt String?
 createdAt DateTime @default(now())
 @@index([workflow, createdAt])
}
model RecordReview {
 id String @id @default(cuid())
 actorId String
 entity String
 entityId String
 version String
 reason String
 createdAt DateTime @default(now())
 @@unique([entity, entityId, version, actorId])
}
model UsageBucket {
 id String @id
 calls Int
}
model IssuedCredential {
 token String @id
 entity String
 entityId String
 version String
 assertion Json
 createdAt DateTime @default(now())
 revokedAt DateTime?
 @@index([entity, entityId, createdAt])
}

model DomainArtifact {
 id String @id @default(cuid())
 subjectEntity String
 subjectId String
 title String
 content String
 contentHash String
 actorId String
 approvedBy String?
 createdAt DateTime @default(now())
 @@index([subjectEntity, subjectId])
}

model RecordApproval {
 id String @id
 version String
}
model DomainExecution {
 id String @id
 actorId String
 connectorId String
 action String
 subjectEntity String
 subjectId String
 version String
 status String
 result Json?
 createdAt DateTime @default(now())
}

model WorkSession {
 id String @id @default(cuid())
 actorId String
 respondentId String
 subjectEntity String
 subjectId String
 questions Json
 answers Json
 currentQuestion String?
 status String
 deadline DateTime
 createdAt DateTime @default(now())
 @@index([respondentId, createdAt])
}
model SessionMedia {
 id String @id @default(cuid())
 sessionId String
 questionId String
 actorId String
 contentType String
 bytes Bytes
 contentHash String
 createdAt DateTime @default(now())
 @@index([sessionId])
}

model AppSetting {
 id String @id
 value Json
 updatedAt DateTime @updatedAt
}

model RepatriationCase {
 id String @id @default(cuid())
 name String
 caseNumber String
 familyReference String
 origin String
 destination String
 coordinator String
 openedAt DateTime
 status String @default("Draft")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 inverseDeceasedRecord_repatriationCaseId DeceasedRecord[] @relation("DeceasedRecord_repatriationCaseId")
 inverseConsularDocument_repatriationCaseId ConsularDocument[] @relation("ConsularDocument_repatriationCaseId")
 inverseDestinationRequirement_repatriationCaseId DestinationRequirement[] @relation("DestinationRequirement_repatriationCaseId")
 inverseFuneralProvider_repatriationCaseId FuneralProvider[] @relation("FuneralProvider_repatriationCaseId")
 inversePreparationRecord_repatriationCaseId PreparationRecord[] @relation("PreparationRecord_repatriationCaseId")
 inverseCargoBooking_repatriationCaseId CargoBooking[] @relation("CargoBooking_repatriationCaseId")
 inverseRepatriationHandoff_repatriationCaseId RepatriationHandoff[] @relation("RepatriationHandoff_repatriationCaseId")
 inverseCaseExpense_repatriationCaseId CaseExpense[] @relation("CaseExpense_repatriationCaseId")
 inverseOperationalTask_repatriationCaseId OperationalTask[] @relation("OperationalTask_repatriationCaseId")
 inverseRuleVersion_repatriationCaseId RuleVersion[] @relation("RuleVersion_repatriationCaseId")
 inverseDocumentRequirement_repatriationCaseId DocumentRequirement[] @relation("DocumentRequirement_repatriationCaseId")
}

model DeceasedRecord {
 id String @id @default(cuid())
 name String
 identityReference String
 dateOfDeath DateTime
 placeOfDeath String
 nationality String
 status String @default("Draft")
 repatriationCaseId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([repatriationCaseId])
 linkedRepatriationCaseId RepatriationCase @relation("DeceasedRecord_repatriationCaseId", fields: [repatriationCaseId], references: [id], onDelete: Restrict)
}

model ConsularDocument {
 id String @id @default(cuid())
